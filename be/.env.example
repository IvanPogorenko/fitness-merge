# Учебные значения для локального запуска. Реальные пароли сюда не записывать.
PORT=3000
NODE_ENV=development

# Учебная PostgreSQL 17 из compose/docker-compose.db.yml (порт 5433 на хосте)
DB_HOST=localhost
DB_PORT=5433
DB_USER=videohost
DB_PASSWORD=videohost_dev_only
DB_NAME=fitness_merge_dev

# Отдельная база для автоматических тестов и одноразовая база для проверки отката миграций
DB_TEST_NAME=fitness_merge_test
DB_SCRATCH_NAME=fitness_merge_scratch

# Размер пула соединений на один процесс приложения
DB_POOL_MAX=4
# true — писать все SQL в лог
DB_LOGGING=false

# Учебный demo-режим: пользователь выбирается заголовком X-Demo-User-Id.
# При NODE_ENV=production приложение с DEMO_AUTH=true не запустится.
DEMO_AUTH=true
